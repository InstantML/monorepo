FROM node:24-bookworm-slim AS builder

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
RUN npm ci

COPY apps/web ./apps/web
COPY apps/docs ./apps/docs

ARG INSTANTML_WEB_API_ENV=staging
ARG INSTANTML_WEB_EXPLICIT_API_BASES=0
ARG INSTANTML_API_BASE
ARG INSTANTML_CONTROL_API_BASE
ARG INSTANTML_DATA_API_BASE
ARG INSTANTML_API_ALLOWED_ORIGINS
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ENV INSTANTML_WEB_API_ENV=${INSTANTML_WEB_API_ENV}
ENV INSTANTML_WEB_EXPLICIT_API_BASES=${INSTANTML_WEB_EXPLICIT_API_BASES}
ENV INSTANTML_API_BASE=${INSTANTML_API_BASE}
ENV INSTANTML_CONTROL_API_BASE=${INSTANTML_CONTROL_API_BASE}
ENV INSTANTML_DATA_API_BASE=${INSTANTML_DATA_API_BASE}
ENV INSTANTML_API_ALLOWED_ORIGINS=${INSTANTML_API_ALLOWED_ORIGINS}
ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=${NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY}
ENV NODE_ENV=production

RUN npm run web:build

FROM node:24-bookworm-slim

WORKDIR /app

ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV INSTANTML_WEB_API_ENV=staging
ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=${NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY}

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/apps/web/.next ./apps/web/.next
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder /app/apps/web/next.config.mjs ./apps/web/next.config.mjs
COPY --from=builder /app/apps/docs ./apps/docs

EXPOSE 8080

CMD ["sh", "-c", "cd apps/web && ../../node_modules/.bin/next start --hostname 0.0.0.0 --port ${PORT:-8080}"]
