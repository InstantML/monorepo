# InstantML monorepo — example environment configuration.
#
# Pattern (effective 2026-05-24):
#   * Non-secret values live here. Copy this file to `.env` and edit defaults
#     to taste. `.env` is gitignored.
#   * Secret values DO NOT live here and DO NOT live in `.env`. They live in
#     Google Secret Manager and are loaded into your shell on demand via
#     `tools/load-secrets.sh`. See `docs/ops/secrets.md` for the workflow.
#
# Each placeholder below carries a comment of the form:
#   # load from Secret Manager: <secret-id>
# Run `source tools/load-secrets.sh` (or `eval "$(tools/load-secrets.sh)"`)
# to populate them from `tools/secrets-manifest.txt`.

# -----------------------------------------------------------------------------
# Local frontend <-> Rust API
# -----------------------------------------------------------------------------

# Local frontend -> Rust API target used by Next rewrites.
INSTANTML_API_BASE=http://127.0.0.1:8000
# Required by Next when `INSTANTML_API_BASE` points at a non-loopback hosted API.
INSTANTML_API_ALLOWED_ORIGINS=

# Optional public equivalent for browser-side tooling if needed later.
NEXT_PUBLIC_INSTANTML_API_BASE=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Rust server observability
# -----------------------------------------------------------------------------

# Hosted Cloud Run deploys use JSON logs; local dev defaults to pretty logs.
INSTANTML_LOG_FORMAT=pretty
RUST_LOG=instantml_rust_server=info,tower_http=info
INSTANTML_SLOW_REQUEST_MS=1000

# -----------------------------------------------------------------------------
# ClickHouse routing (non-secret)
# -----------------------------------------------------------------------------

# Hosted ClickHouse routing. Leave disabled for normal local development.
INSTANTML_HOSTED_CLICKHOUSE_ENABLED=false
# `database` is the current self-hosted GCP/default path; `cloud-service` is
# legacy operator-only and can create paid external services.
INSTANTML_CLICKHOUSE_PROVISIONER=database
INSTANTML_TENANT_CLICKHOUSE_URL=

# Cloud-service provisioning knobs (no secret in here, just configuration).
CLICKHOUSE_CLOUD_ENDPOINT=https://api.clickhouse.cloud
INSTANTML_CLICKHOUSE_CLOUD_ORG_ID=
INSTANTML_CLICKHOUSE_CLOUD_PROVIDER=aws
INSTANTML_CLICKHOUSE_CLOUD_REGION=us-east-1
# Comma-separated CIDRs for tenant CH service query access. Hosted deploys
# pin this to the static NAT egress IP so new services are not publicly open.
INSTANTML_CLICKHOUSE_CLOUD_IP_ACCESS_LIST=136.115.243.188/32
INSTANTML_CLICKHOUSE_CLOUD_MIN_REPLICA_MEMORY_GB=8
INSTANTML_CLICKHOUSE_CLOUD_MAX_REPLICA_MEMORY_GB=8
INSTANTML_CLICKHOUSE_CLOUD_NUM_REPLICAS=1
# Keep plan-selected Premium/Pro warehouse size as recorded intent only unless
# payment/spend gates are in place.
INSTANTML_CLICKHOUSE_CLOUD_ALLOW_PLAN_SIZING=false
INSTANTML_CLICKHOUSE_CLOUD_WAIT_SECONDS=600
INSTANTML_ALLOW_USER_DATA_STORED_TENANT_PASSWORDS=false

# Customer-owned GCP ClickHouse BYOC setup.
# Hosted BYOC validation is disabled until these egress values are set
# explicitly; the legacy ClickHouse Cloud allowlist is not used as a fallback.
INSTANTML_BYOC_EGRESS_CIDRS=
INSTANTML_BYOC_EGRESS_SET_VERSION=
INSTANTML_BYOC_SECRET_BACKEND=disabled
INSTANTML_BYOC_SECRET_PROJECT_ID=
INSTANTML_BYOC_SECRET_PREFIX=instantml-byoc-clickhouse
INSTANTML_BYOC_ALLOW_PRIVATE_ENDPOINTS=false

# -----------------------------------------------------------------------------
# ClickHouse credentials (SECRETS — Secret Manager source of truth)
# -----------------------------------------------------------------------------
# Unset here. `source tools/load-secrets.sh` exports them from Secret Manager.

# load from Secret Manager: instantml-clickhouse-user-data-endpoint
CLICKHOUSE_INSTANTML_USER_DATA_ENDPOINT=
# load from Secret Manager: instantml-clickhouse-user-data-username
CLICKHOUSE_INSTANTML_USER_DATA_USERNAME=
# load from Secret Manager: instantml-clickhouse-user-data-password
CLICKHOUSE_INSTANTML_USER_DATA_PASSWORD=
# load from Secret Manager: instantml-clickhouse-cloud-key-id
CLICKHOUSE_INSTANTML_GENERAL_KEY_ID=
# load from Secret Manager: instantml-clickhouse-cloud-key-secret
CLICKHOUSE_INSTANTML_GENERAL_KEY_SECRET=

# -----------------------------------------------------------------------------
# Clerk auth
# -----------------------------------------------------------------------------
# CLERK_SECRET_KEY is a server-side secret; the publishable key is technically
# public but kept in Secret Manager too so it cannot drift out of lock-step
# with the secret key (that drift caused a production deploy block this week).

# load from Secret Manager: instantml-clerk-secret-key
CLERK_SECRET_KEY=
# load from Secret Manager: instantml-clerk-publishable-key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk Backend API base. Non-secret.
CLERK_API_BASE=https://api.clerk.com
# Derived from the publishable key by the deploy validator; override only to
# pin a specific Clerk instance for a forensic deploy.
CLERK_JWT_ISSUER=

# -----------------------------------------------------------------------------
# Billing (Stripe)
# -----------------------------------------------------------------------------

# load from Secret Manager: instantml-stripe-secret-key
STRIPE_SECRET_KEY=
# load from Secret Manager: instantml-stripe-webhook-secret
STRIPE_WEBHOOK_SECRET=
# Non-secret: API version pin and public price id.
STRIPE_API_VERSION=
STRIPE_PRO_PRICE_ID=
INSTANTML_BILLING_ENABLED=
INSTANTML_BILLING_SUCCESS_URL=
INSTANTML_BILLING_CANCEL_URL=
INSTANTML_BILLING_GRACE_DAYS=

# -----------------------------------------------------------------------------
# Transactional email (Resend)
# -----------------------------------------------------------------------------

# load from Secret Manager: instantml-resend-api-key
RESEND_API_KEY=
INSTANTML_EMAIL_PROVIDER=resend
INSTANTML_EMAIL_FROM=
INSTANTML_EMAIL_REPLY_TO=
INSTANTML_SUPPORT_EMAIL=

# -----------------------------------------------------------------------------
# Bootstrap / admin
# -----------------------------------------------------------------------------

# load from Secret Manager: instantml-bootstrap-token
INSTANTML_BOOTSTRAP_TOKEN=

# -----------------------------------------------------------------------------
# Hosted deploy helper / Cloud Run metadata (non-secret)
# -----------------------------------------------------------------------------

GCP_PROJECT=
GCP_REGION=us-central1
INSTANTML_CLOUD_RUN_SERVICE=instantml-rust-api
INSTANTML_ARTIFACT_REPOSITORY=instantml
INSTANTML_ALLOWED_FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Restrict hosted Clerk signups so public Cloud Run cannot create paid tenant
# warehouses for arbitrary users. Deploy helper defaults to active gcloud
# account email when unset.
INSTANTML_SIGNUP_ALLOWED_EMAILS=
INSTANTML_SIGNUP_ALLOWED_DOMAINS=

# -----------------------------------------------------------------------------
# Artifact storage (Cloudflare R2)
# -----------------------------------------------------------------------------
# Local dev uses filesystem storage by default. Hosted sets
# INSTANTML_ARTIFACT_BACKEND=r2.

INSTANTML_ARTIFACT_BACKEND=local
INSTANTML_ARTIFACT_UPLOADS_ENABLED=false
INSTANTML_ARTIFACT_ROOT=.instantml/rust-artifacts
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_PREFIX=instantml-org
CLOUDFLARE_R2_ENDPOINT=

# R2 credentials. The server can derive S3 keys from the API token alone, so
# you only need the explicit S3 pair if you are using an unrelated S3-compat
# account. If the Cloudflare token has Client IP Address Filtering, include
# every Cloud Run static egress IP that will upload artifacts.
# load from Secret Manager: instantml-cloudflare-r2-api-key
CLOUDFLARE_R2_API_KEY=
# load from Secret Manager: instantml-cloudflare-api-token (optional)
CLOUDFLARE_API_TOKEN=
# load from Secret Manager: instantml-cloudflare-r2-access-key-id (optional)
CLOUDFLARE_R2_ACCESS_KEY_ID=
# load from Secret Manager: instantml-cloudflare-r2-secret-access-key (optional)
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Demo / benchmark gates (non-secret)
# -----------------------------------------------------------------------------

# Required only when intentionally running the real hosted demo benchmark seed.
INSTANTML_HOSTED_DEMO_ALLOW_PROVISION=0
