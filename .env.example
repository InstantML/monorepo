# Local frontend -> Node API target used by Next rewrites.
RLOBS_API_BASE=http://127.0.0.1:8000

# Optional public equivalent for browser-side tooling if needed later.
NEXT_PUBLIC_RLOBS_API_BASE=http://127.0.0.1:8000

# Hosted ClickHouse routing. Leave disabled for normal local development.
RLOBS_HOSTED_CLICKHOUSE_ENABLED=false
# database mode is a local/test convenience unless you also create per-org
# least-privilege users; cloud-service can create external paid services.
RLOBS_CLICKHOUSE_PROVISIONER=database
CLICKHOUSE_INSTANTML_USER_DATA_ENDPOINT=https://example.clickhouse.cloud:8443/default
CLICKHOUSE_INSTANTML_USER_DATA_USERNAME=default
CLICKHOUSE_INSTANTML_USER_DATA_PASSWORD=
RLOBS_TENANT_CLICKHOUSE_URL=

# Opt-in cloud-service provisioning. These can create external ClickHouse Cloud services.
CLICKHOUSE_CLOUD_ENDPOINT=https://api.clickhouse.cloud
CLICKHOUSE_INSTANTML_GENERAL_KEY_ID=
CLICKHOUSE_INSTANTML_GENERAL_KEY_SECRET=
# Optional when the key can discover an organization through GET /v1/organizations.
RLOBS_CLICKHOUSE_CLOUD_ORG_ID=
RLOBS_CLICKHOUSE_CLOUD_PROVIDER=aws
RLOBS_CLICKHOUSE_CLOUD_REGION=us-east-1
# Comma-separated CIDRs for tenant service query access. Tighten to API egress in production.
RLOBS_CLICKHOUSE_CLOUD_IP_ACCESS_LIST=0.0.0.0/0
RLOBS_CLICKHOUSE_CLOUD_MIN_REPLICA_MEMORY_GB=8
RLOBS_CLICKHOUSE_CLOUD_MAX_REPLICA_MEMORY_GB=8
RLOBS_CLICKHOUSE_CLOUD_NUM_REPLICAS=1
RLOBS_CLICKHOUSE_CLOUD_WAIT_SECONDS=600
RLOBS_ALLOW_USER_DATA_STORED_TENANT_PASSWORDS=false

# Required only when intentionally running the real hosted demo benchmark seed.
RLOBS_HOSTED_DEMO_ALLOW_PROVISION=0
