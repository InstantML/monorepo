erDiagram
  ORGANIZATIONS ||--o{ MEMBERSHIPS : has
  USERS ||--o{ MEMBERSHIPS : joins
  USERS ||--o{ USER_IDENTITIES : authenticates_with
  ORGANIZATIONS ||--o{ SERVICE_ACCOUNTS : owns
  SERVICE_ACCOUNTS ||--o{ API_KEYS : issues
  ORGANIZATIONS ||--o{ PROJECTS : owns
  PROJECTS ||--o{ RUNS : contains
  RUNS ||--o{ METRIC_SERIES : has
  METRIC_SERIES ||--o{ METRIC_POINTS : contains
  RUNS ||--o{ ATTRIBUTE_EVENTS : records
  RUNS ||--o{ RUN_ATTRIBUTE_CURRENT : summarizes
  RUNS ||--o{ ARTIFACTS : owns
  ORGANIZATIONS ||--o{ IMPORT_JOBS : runs
  IMPORT_JOBS ||--o{ IMPORT_JOB_RUNS : creates
