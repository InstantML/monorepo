{
  "name": "instantml",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "scripts": {
    "setup": "npm run setup:python && npm run setup:playwright && npm run check:setup",
    "check:setup": "node tools/check-setup.mjs",
    "setup:python": "python3 -m pip install -r requirements-dev.txt",
    "setup:playwright": "npx playwright install chromium",
    "dev:api": "node tools/dev-rust-api.mjs",
    "dev:api:rust": "node tools/dev-rust-api.mjs",
    "dev:api:node": "node apps/server/src/server.js --db .instantml/instantml.json --port 8000",
    "dev:web": "cd apps/web && ../../node_modules/.bin/next dev --port 3000",
    "admin:dev": "cd apps/admin && ../../node_modules/.bin/next dev --port 3001",
    "admin:build": "cd apps/admin && ../../node_modules/.bin/next build",
    "admin:start": "cd apps/admin && ../../node_modules/.bin/next start --port 3001",
    "test": "npm run test:node && npm run test:deploy-cloud-run && npm run docs:validate && npm run rust:test && npm run test:python",
    "test:python": "python3 -m pytest",
    "sdk:build": "python3 -m build packages/python-sdk",
    "sdk:check": "python3 -m twine check packages/python-sdk/dist/*",
    "sdk:test-install": "python3 -m pip install --force-reinstall packages/python-sdk/dist/instantml-*.whl && python3 -c \"import instantml as im; print(im.Client())\"",
    "test:node": "node --test --experimental-test-coverage apps/server/tests/*.test.js apps/web/tests/*.test.js apps/admin/tests/*.test.js",
    "test:deploy-cloud-run": "node --test tools/tests/*.test.js",
    "test:contract": "npm run test:rust:contract",
    "test:contract:direct": "node tools/contract-smoke.mjs",
    "test:contract:node": "INSTANTML_CONTRACT_BACKEND=node node tools/contract-smoke.mjs",
    "test:rust:contract": "node tools/rust-service-smoke.mjs contract",
    "test:rust:sdk": "node tools/rust-service-smoke.mjs sdk",
    "test:rust:ui": "node tools/rust-service-smoke.mjs ui",
    "test:stripe-billing": "node tools/stripe-billing-smoke.mjs",
    "test:byoc-clickhouse": "node tools/byoc-clickhouse-smoke.mjs",
    "test:hosted-clickhouse": "node tools/hosted-clickhouse-smoke.mjs",
    "test:scale": "node tools/scale-smoke.mjs",
    "benchmark:large-runs": "node tools/rust-large-run-benchmark.mjs",
    "benchmark:hosted-demo": "node tools/hosted-demo-seed-benchmark.mjs",
    "benchmark:cloud-run": "node tools/hosted-cloud-run-benchmark.mjs",
    "benchmark:sdk-overhead": "python3 benchmarks/sdk_logging_overhead.py run",
    "seed:hosted-scale": "node tools/hosted-tenant-scale-seed.mjs",
    "benchmark:rich-objects": "node tools/rust-rich-objects-benchmark.mjs",
    "benchmark:rank-insights": "node tools/rank-insights-benchmark.mjs",
    "example:rank-scale": "node examples/rank-insights/scale-projects.mjs",
    "deploy:cloud-run": "node tools/deploy-cloud-run.mjs --topology=split",
    "deploy:cloud-run:single": "node tools/deploy-cloud-run.mjs --topology=single",
    "deploy:cloud-run:multi": "node tools/deploy-cloud-run.mjs --topology=split",
    "deploy:cloud-run:staging": "node tools/deploy-cloud-run.mjs --topology=split --environment=staging --public-router",
    "docs:sync-openapi": "node tools/sync-docs-openapi.mjs",
    "docs:check-openapi": "node tools/sync-docs-openapi.mjs --check",
    "docs:test": "node --test apps/web/tests/docs-route.test.js tools/tests/docs-openapi.test.js tools/tests/benchmark-docs.test.js tools/tests/docs-screenshots.test.js",
    "docs:dev": "npm run docs:sync-openapi && cd apps/docs && ../../node_modules/.bin/mint dev",
    "docs:validate": "npm run docs:check-openapi && node tools/validate-docs-content.mjs && node tools/validate-docs-snippets.mjs && cd apps/docs && ../../node_modules/.bin/mint validate",
    "test:all": "npm run check:setup && npm run rust:lint && npm run rust:test && npm run test:node && npm run test:deploy-cloud-run && npm run docs:validate && npm run test:python && npm run test:contract && npm run test:rust:sdk && npm run test:scale && npm run test:ui",
    "test:ui": "node tools/rust-service-smoke.mjs ui",
    "test:ui:direct": "node apps/web/tests/ui-smoke.mjs",
    "test:ui:node": "INSTANTML_UI_SMOKE_BACKEND=node node apps/web/tests/ui-smoke.mjs",
    "rust:fmt": "cargo fmt --manifest-path apps/rust-server/Cargo.toml --all",
    "rust:lint": "cargo clippy --manifest-path apps/rust-server/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path apps/rust-server/Cargo.toml",
    "rust:migrate": "cargo run --manifest-path apps/rust-server/Cargo.toml -- migrate",
    "rust:serve": "cargo run --manifest-path apps/rust-server/Cargo.toml -- serve",
    "rust:capacity-plan": "cargo run --quiet --manifest-path apps/rust-server/Cargo.toml -- capacity-plan",
    "web:dev": "cd apps/web && ../../node_modules/.bin/next dev --port 3000",
    "web:build": "cd apps/web && ../../node_modules/.bin/next build",
    "web:start": "cd apps/web && ../../node_modules/.bin/next start --port 3000",
    "start": "npm run dev:api",
    "start:node": "node apps/server/src/server.js",
    "rust:fmt:check": "cargo fmt --manifest-path apps/rust-server/Cargo.toml --all -- --check",
    "rust:verify": "npm run rust:fmt:check && npm run rust:lint && npm run rust:test && npm run test:rust:contract && npm run test:hosted-clickhouse",
    "codegen:api": "node tools/codegen-api.mjs",
    "verify:api-types": "node tools/codegen-api.mjs --check"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "mint": "4.2.577",
    "openapi-typescript": "7.5.2",
    "playwright": "1.59.1",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@clerk/nextjs": "7.3.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "lucide-react": "0.564.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "overrides": {
    "postcss": "8.5.14",
    "react": "19.2.6"
  }
}
